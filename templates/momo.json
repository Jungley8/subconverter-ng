{
  "log": {
    "disabled": false,
    "level": "info",
    "output": "",
    "timestamp": true
  },
  "dns": {
    "strategy": "prefer_ipv4",
    "disable_cache": false,
    "disable_expire": false,
    "cache_capacity": 4096,
    "servers": [
      {
        "tag": "hosts-dns",
        "type": "hosts",
        "path": [
          "/etc/hosts"
        ]
      },
      {
        "tag": "lan-dns",
        "type": "udp",
        "server": "127.0.0.1",
        "server_port": 53
      },
      
      {
        "tag": "alidns-doh",
        "type": "https",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "dns.alidns.com"
        }
      },
      
      {
        "tag": "apple-doh",
        "type": "https",
        "server": "doh.dns.apple.com",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "alidns-doh",
        "tls": {
          "enabled": true,
          "server_name": "doh.dns.apple.com"
        }
      },
      {
        "tag": "hgc-dns",
        "type": "tcp",
        "server": "210.0.255.251",
        "server_port": 53
      },
      {
        "tag": "google-dns",
        "type": "tcp",
        "server": "8.8.4.4",
        "server_port": 53
      },
      
      
      
      {
        "tag": "fake-ip-dns-server",
        "type": "fakeip",
        "inet4_range": "100.127.0.0/16",
        "inet6_range": "2001:2::/48"
      }
    ],
    "rules": [
      {
        "domain": [
          "localhost"
        ],
        "server": "hosts-dns",
        "action": "route"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "domain_suffix": [
              ".lan",
              ".local",
              ".home.arpa"
            ]
          },
          {
            "domain_regex": [
              "^[^.]+$"
            ]
          }
        ],
        "server": "lan-dns",
        "action": "route"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "rule_set": [
              "geosite-ai-not-cn"
            ],
            "query_type": [
              "AAAA"
            ]
          },
          {
            "domain_suffix": [
              "openai.com",
              "chatgpt.com",
              "oaistatic.com",
              "oaiusercontent.com",
              "anthropic.com",
              "claude.ai",
              "gemini.google.com",
              "copilot.microsoft.com",
              "grok.com",
              "x.ai",
              "perplexity.ai"
            ],
            "query_type": [
              "AAAA"
            ]
          }
        ],
        "action": "predefined",
        "rcode": "NOERROR",
        "answer": []
      },
      {
        "clash_mode": "Direct",
        "server": "alidns-doh",
        "action": "route"
      },
      {
        "clash_mode": "Global",
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fake-ip-dns-server",
        "rewrite_ttl": 1,
        "action": "route"
      },
      {
        "inbound": [
          "dns-in-fakeip"
        ],
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fake-ip-dns-server",
        "rewrite_ttl": 1,
        "action": "route"
      },
      {
        "rule_set": [
          "geosite-apple-cn"
        ],
        "server": "apple-doh",
        "action": "route"
      },
      {
        "rule_set": [
